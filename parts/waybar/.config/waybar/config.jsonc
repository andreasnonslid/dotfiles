// GENERATED by scripts/theme.py. Do not edit.
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 8,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": [],
    "modules-right": ["mpris", "tray", "bluetooth", "network", "pulseaudio", "backlight", "battery", "cpu", "memory", "clock", "custom/ready"],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{index} {windows}",
        "window-format": "{icon}",
        "window-rewrite-default": "",
        "window-rewrite": {
        "class<[Aa]lacritty|foot|kitty>": "",
        "class<[Ff]irefox.*>": "",
        "class<[Cc]hrom.*|[Bb]rave.*|[Gg]oogle-chrome.*>": "",
        "class<[Cc]ode.*|[Cc]ursor.*|[Zz]ed.*>": "",
        "class<[Oo]bsidian>": "󰭮",
        "class<org.gnome.[Nn]autilus|[Tt]hunar>": "",
        "class<[Ss]lack>": "",
        "class<[Dd]iscord>": "",
        "class<[Ss]potify>": "",
        "class<[Pp]avucontrol>": "",
        "class<[Ll]ibreoffice.*>": "",
        "class<mpv|vlc>": ""
        }
    },

    "mpris": {
        "format": "{status_icon}  {title}",
        "status-icons": { "playing": "", "paused": "" },
        "max-length": 34,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}: {artist} – {title}"
    },

    "bluetooth": {
        "format": "",
        "format-off": "",
        "format-connected": "  {device_alias}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "network": {
        "align": 0.5,
        "format-wifi": "󰖩  {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪  offline",
        "max-length": 20,
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
        "on-click": "alacritty --class nmtui-float -e nmtui",
        "on-click-right": "nm-connection-editor"
    },

    "pulseaudio": {
        "align": 0.5,
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "backlight": {
        "format": "󰃠",
        "tooltip-format": "Brightness {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "align": 0.5,
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁿", "󰂁", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "cpu": {
        "interval": 3,
        "states": { "warning": 85 },
        "format": "",
        "format-warning": "󰻠  {usage}%"
    },

    "memory": {
        "interval": 5,
        "states": { "warning": 85 },
        "format": "",
        "format-warning": "󰍛  {percentage}%"
    },

    "clock": {
        "align": 0.5,
        "format": "  {:%a %d %b   %H:%M}",
        "format-alt": "  {:%H:%M}",
        "tooltip-format": "{calendar}"
    },

    "tray": { "spacing": 8 },

    "custom/ready": { "format": "", "exec": "touch $XDG_RUNTIME_DIR/waybar-ready", "interval": "once", "tooltip": false }
}
