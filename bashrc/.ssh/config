# Base ssh_config, symlinked to ~/.ssh/config by symlink.py.
#
# Host- and identity-specific blocks (per-employer git hosts, VPN jump
# hosts, ...) stay out of git and live in ~/.local/secrets/ssh/*.conf
# instead -- same scheme as the git identity split in
# ~/.local/secrets/git/{personal,work}.gitconfig (see README.md). Missing
# files/directories are silently skipped by ssh's Include, not an error.
# ssh/setup_git_host.sh writes into that directory.
Include ~/.local/secrets/ssh/*.conf

# macOS keeps unlocked key passphrases in the login Keychain instead of
# asking every session (UseKeychain). That keyword only exists in Apple's
# OpenSSH fork -- a non-Apple build refuses to parse it -- so it can't live
# in this cross-platform file. symlink.py links config.darwin in only on
# darwin; ssh's Include silently skips a target that isn't there.
Include ~/.ssh/config.darwin

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
