# Ghostty config (M17). Darwin-only -- linked by symlink.py, excluded on
# Linux by DARWIN_ONLY_CONFIG. Mirrors the minimal chrome of
# windows/wezterm.lua (no tab bar, SteadyBlock cursor).
#
# Shell: uses your login shell from passwd (chsh). No command= override --
# Ghostty's custom command adds --posix, which breaks dotfiles aliases/functions.
#
# Check after editing:  ghostty +validate-config
# Reload a running Ghostty:  cmd+shift+,

# --- Font --------------------------------------------------------------------
# Iosevka Term in its Extended width (brew install --cask font-iosevka): the
# same design as the normal cut, but less cramped, so it reads without effort.
# Nerd Font icons come from Ghostty's built-in symbol font, so no patched font
# is needed (IosevkaTerm Nerd Font Mono stays installed for Zed).
font-family = Iosevka Term
font-style = Extended
font-style-bold = Bold Extended
font-style-italic = Extended Italic
font-style-bold-italic = Bold Extended Italic
font-size = 16
# Heavier strokes: both monitors are 1x (non-Retina), where macOS draws thin.
font-thicken = true
# Extra line height so lines in a block stay visually apart.
adjust-cell-height = 15%

# --- Colours -------------------------------------------------------------------
# Built-in Ghostty theme; browse them with `ghostty +list-themes` (interactive
# preview), e.g. theme = light:Catppuccin Latte,dark:Catppuccin Mocha to follow
# macOS appearance. `theme = dotfiles` instead uses the scripts/theme.py palette
# (themes/dotfiles), matching zellij, starship and nvim.
theme = Dark Pastel

# --- Cursor --------------------------------------------------------------------
# SteadyBlock, matching the WezTerm default_cursor_style. Shell integration
# would otherwise switch to a bar at the prompt (its "cursor" feature).
cursor-style = block
cursor-style-blink = false

# --- Shell integration -----------------------------------------------------------
# Keep prompt marks / cwd / title, but not the cursor override. ssh-terminfo
# installs Ghostty's terminfo on hosts you ssh into (no "unknown terminal
# xterm-ghostty"), ssh-env falls back to xterm-256color where it can't.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# --- Window ----------------------------------------------------------------------
# No tab bar: zellij owns pane/window multiplexing here, same as under WezTerm.
# AeroSpace tiles every window, so the macOS title bar only costs a row.
macos-titlebar-style = hidden
# A little breathing room around the text; leftover sub-cell pixels are spread
# evenly and painted with the edge cells' colour, so zellij's bars still look
# edge-to-edge instead of leaving a seam.
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true
window-padding-color = extend

# Generous scrollback -- WezTerm is set to 10k lines; Ghostty sizes its
# buffer in bytes instead, so this isn't a literal conversion, just "a lot".
scrollback-limit = 10000000

mouse-hide-while-typing = true

# --- Keyboard --------------------------------------------------------------------
# Left Option sends Alt for zellij/nvim bindings; right Option keeps typing
# characters (æ ø å, € ...) on the US International layout.
macos-option-as-alt = left
